{
  "name": "floatbet-gaming",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vite build --config smoke/vite.smoke.config.ts && node smoke/dist/entry.js",
    "test:ui": "vite build --config smoke/vite.ui.config.ts && node smoke/dist-ui/ui.js",
    "test:layout": "vite build --config smoke/vite.layout.config.ts && node smoke/dist-layout/layout.js",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:zp": "vite build --config smoke/vite.zp.config.ts && node smoke/dist-zp/zp.js",
    "test:wire": "node scripts/build-edge-functions.mjs --check && vite build --config smoke/vite.wire.config.ts && node smoke/dist-wire/wire.js",
    "test:routes": "vite build --config smoke/vite.routes.config.ts && node smoke/dist-routes/routes.js",
    "test:edge": "node scripts/build-edge-functions.mjs --check && vite build --config smoke/vite.edge.config.ts && node smoke/dist-edge/edge.js",
    "test:api": "vite build --config smoke/vite.api.config.ts && node smoke/dist-api/api.js",
    "test:success": "vite build --config smoke/vite.success.config.ts && node smoke/dist-success/success.js",
    "test:migration": "vite build --config smoke/vite.migration.config.ts && node smoke/dist-migration/migration.js",
    "test:modes": "vite build --config smoke/vite.modes.config.ts && node smoke/dist-modes/modes.js",
    "test:pwa": "vite build --config smoke/vite.pwa.config.ts && node smoke/dist-pwa/pwa.js",
    "favicon": "vite build --config smoke/vite.favicon.config.ts && node smoke/dist-favicon/gen-favicon.js",
    "icons": "npm run favicon && node scripts/build-icons.mjs",
    "icons:android": "node scripts/build-android-icons.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:reels": "vite build --config smoke/vite.reels.config.ts && node smoke/dist-reels/reels.js",
    "test:slotboard": "vite build --config smoke/vite.slotcheck.config.ts && node smoke/dist-slotcheck/slotcheck.js",
    "test:celebrate": "vite build --config smoke/vite.celebrate.config.ts && node smoke/dist-celebrate/celebrate.js",
    "test:feed": "vite build --config smoke/vite.feed.config.ts && node smoke/dist-feed/feed.js",
    "test:sports": "vite build --config smoke/vite.sports.config.ts && node smoke/dist-sports/sports.js",
    "test:craters": "vite build --config smoke/vite.craters.config.ts && node smoke/dist-craters/craters.js",
    "test:deploy": "node scripts/build-edge-functions.mjs --check && vite build --config smoke/vite.deploy.config.ts && node smoke/dist-deploy/deploy.js",
    "test:auth": "vite build --config smoke/vite.auth.config.ts && node smoke/dist-auth/auth.js",
    "test:brand": "vite build --config smoke/vite.brand.config.ts && node smoke/dist-brand/brand.js",
    "edge:build": "node scripts/build-edge-functions.mjs",
    "edge:check": "node scripts/build-edge-functions.mjs --check",
    "test:groq": "vite build --config smoke/vite.groq.config.ts && node smoke/dist-groq/groqcheck.js",
    "lint": "eslint src/ --max-warnings=99",
    "test:signedin": "vite build --config smoke/vite.signedin.config.ts && node smoke/dist-signedin/signedin.js",
    "test:readiness": "vite build --config smoke/vite.readiness.config.ts && node smoke/dist-readiness/readiness.js",
    "test:settle": "vite build --config smoke/vite.settle.config.ts && node smoke/dist-settle/settle.js",
    "test:board": "npm run edge:build && vite build --config smoke/vite.board.config.ts && node smoke/dist-board/board.js",
    "test:games": "vite build --config smoke/vite.games.config.ts && node smoke/dist-games/games.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
