# ---------------------------------------------------------------------------
# FloatBet / Shopper — browser configuration
#
# Copy to `.env.local` for development. Every VITE_ var is embedded in the
# public bundle, so only put public values here. Never add a DGateway key, a
# service-role key or a webhook secret: those belong in Supabase secrets.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: public base URL of the app, used for auth redirect links.
VITE_APP_URL=https://shoppa-ten.vercel.app
