# ---------------------------------------------------------------------------
# Server-side config  (NEVER prefix these with VITE_)
#
# On this deployment these live as Supabase Edge Function secrets, not Vercel
# env vars: the /api routes are Edge Functions now (`pay`, `admin-ops`, …).
#
#   supabase secrets set ZENGAPAY_API_TOKEN=…      # or Dashboard → Edge Functions → Secrets
#
# They are read only inside the functions and are never bundled into the
# browser. This file is the list of names; it holds no values.
# ---------------------------------------------------------------------------

# ZENGAPAY. Docs: https://zengapay.gitbook.io/api-docs
# Production: https://api.zengapay.com/v1
# Sandbox:    https://api.sandbox.zengapay.com/v1   (below, uncomment)
ZENGAPAY_API_URL=https://api.zengapay.com/v1
# ZPYPUBK-… . Separate keys per environment; the wrong one answers 401 with
# `data.env` telling you which environment it belongs to.
ZENGAPAY_API_TOKEN=

# The Secret Hash from Dashboard -> Developer Settings -> Webhooks.
#
# REQUIRED IN LIVE MODE. Without it a real charge could be taken and never
# credited, because every webhook fails its HMAC check. The functions refuse the
# payment with 503 WEBHOOK_SECRET_MISSING rather than take money they cannot
# account for.
#
# The signature is HMAC-SHA256 over transactionReference + msisdn + amount
# concatenated with no separator -- NOT over the raw body. Header:
# X-ZENGAPAY-SIGNATURE.
ZENGAPAY_WEBHOOK_SECRET=

# Public origin the provider sends the player back to after hosted checkout.
# MUST be the domain players actually use: this builds return_url and
# cancel_url. It is not a cosmetic default -- the wrong host returns a player to
# a site that does not exist after they have paid.
APP_URL=https://floatbet.space

# Supabase service role, used inside the functions to read/write orders and
# credit wallets. Service role bypasses RLS -- server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Browser config. VITE_ vars ARE embedded in the public bundle: public only.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://floatbet.space

# ---------------------------------------------------------------------------
# Sportsbook odds feed (The Odds API)
# ---------------------------------------------------------------------------
# Server only -- the key is billable and every call is made from the functions.
# Free Starter plan: 500 credits a month. One credit = one request for one
# sport + one market + one region, so the sport list in feed-sync is a budget,
# not a preference.
ODDS_API_KEY=
ODDS_API_URL=https://api.the-odds-api.com/v4
# Overround kept on top of the consensus price, in percent. 4 is deliberate:
# see docs/SPORTS.md §9. Zero means running a book with no margin at all.
ODDS_MARGIN_PCT=4
