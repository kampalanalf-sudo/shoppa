# ---------------------------------------------------------------------------
# Server-side payment config  (NEVER prefix these with VITE_)
#
# Set these in the Vercel dashboard (Project → Settings → Environment Variables)
# or in .env.local for `vercel dev`. They are read only by the /api routes and
# are never bundled into the browser.
# ---------------------------------------------------------------------------

# DGateway. Base URL + API key. The key must stay on the server.
DGATEWAY_API_URL=https://dgatewayapi.desispay.com
DGATEWAY_API_KEY=
DGATEWAY_WEBHOOK_SECRET=
# Hosted-store mode. The store page URL buyers are sent to, and the store slug
# used to reject payments belonging to a different shop.
VITE_DGATEWAY_STORE_URL=https://dgatewayadmin.desispay.com/store/shop/floatbet?products
DGATEWAY_STORE_SLUG=floatbet

# Public origin used to build the callback_url DGateway posts back to.
APP_URL=https://shoppa-ten.vercel.app

# Supabase service role, used by the server routes to read/write orders and
# credit wallets. Service role bypasses RLS — server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Browser config. VITE_ vars ARE embedded in the public bundle: public only.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://shoppa-ten.vercel.app

# ---------------------------------------------------------------------------
# Sportsbook odds feed (The Odds API)
# ---------------------------------------------------------------------------
# Server only — the key is billable and every call is made from /api routes.
# Free Starter plan: 500 credits a month. One credit = one request for one
# sport + one market + one region, so the sport list in api/feed/sync.ts is a
# budget, not a preference.
ODDS_API_KEY=
# Any long random string. Vercel sends it as a bearer token to the cron routes,
# so /api/feed/sync cannot be triggered by a stranger.
CRON_SECRET=
# Overround kept on top of the consensus price, in percent. 4 is deliberate:
# see docs/SPORTS.md §9. Zero means running a book with no margin at all.
ODDS_MARGIN_PCT=4
